{
  "name": "pancake-auction",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx scripts/cli.ts dev",
    "build": "next build && tsx scripts/clean-generated.ts",
    "start": "tsx scripts/cli.ts start",
    "league:managers": "tsx scripts/cli.ts managers",
    "seat:release": "tsx scripts/cli.ts release",
    "import:sleeper": "tsx scripts/import.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run tests/rules.test.ts tests/import.test.ts tests/simulation.test.ts tests/review.test.tsx tests/import-cache.test.ts tests/evidence.test.ts tests/local-ports.test.ts tests/mutation-retry.test.ts tests/port-closure.test.ts",
    "test:db": "tsx tests/teardown.ts && tsx tests/db.ts && tsx tests/review-db.ts && tsx tests/pool-process.ts && tsx tests/done-db.ts",
    "sim": "tsx scripts/sim.ts",
    "verify": "tsx scripts/verify.ts",
    "league:check": "tsx scripts/cli.ts check",
    "test:ui": "tsx tests/ui.ts && tsx tests/preference.ts && tsx tests/connection.ts",
    "test:volume": "tsx tests/pool-volume.ts",
    "test:room": "tsx tests/ui-import.ts",
    "test:layout": "tsx tests/layout.ts",
    "backend:local": "tsx scripts/local-dev.ts",
    "test:local": "tsx tests/local-dev.ts"
  },
  "dependencies": {
    "convex": "^1.46.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
